# Bluetooth
ro.bluetooth.dun=true
ro.bluetooth.sap=true
ro.qualcomm.bluetooth.ftp=true
ro.qualcomm.bluetooth.hfp=true
ro.qualcomm.bluetooth.hsp=true
ro.qualcomm.bluetooth.map=true
ro.qualcomm.bluetooth.nap=true
ro.qualcomm.bluetooth.opp=true
ro.qualcomm.bluetooth.pbap=true
# Deactivate BatteryExternalStatsWorker
ro.bluetooth.emb_wp_mode=false

# Display
ro.surface_flinger.primary_display_orientation=270

# Radio & RIL Framework Fix (32-Bit & Single SIM)
vendor.rild.libpath=/vendor/lib/libsec-ril.so
ro.multisim.simslotcount=1
persist.radio.multisim.config=single
telephony.lteOnGsmDevice=1

# Qualcomm Netzmanagement 
persist.data.netmgrd.qos.enable=true
persist.data.qmi.adb_logmask=0
persist.radio.add_power_save=1
ro.telephony.mms_data_profile=5
ro.ril.telephony.qan_resp_strings=6
ro.telephony.call_ring.multiple=0



